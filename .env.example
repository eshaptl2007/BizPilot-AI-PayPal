# ---- Backend (copy to backend/.env for local runs, or to ./.env for docker compose) ----
PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://bizpilot:bizpilot@localhost:5432/bizpilot
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_CLIENT_URL=http://localhost:5173

# ---- PayPal (REST app in the SANDBOX tab of https://developer.paypal.com/dashboard/applications) ----
# Leave the credentials empty to run in offline "mock" mode (fake payments, development only).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
# PAYPAL_MODE=sandbox   # sandbox (default when credentials exist) | live | mock

# ---- AI (optional: without a key the deterministic rule engine answers) ----
# AI_PROVIDER=anthropic   # anthropic | openai | rules  (auto-detected from the key below)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Password-reset email (optional). Without SMTP_HOST the reset link is printed in the backend terminal
#      and shown on screen in development, so you can test "Forgot password" with no mail server.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=BizPilot AI <no-reply@yourdomain.com>
RESET_TOKEN_MINUTES=30

# ---- Currency & time zone ----
# Shop prices are in Indian rupees (INR). PayPal cannot charge INR, so at checkout PayPal charges
# PAYPAL_CURRENCY (USD) converted at PAYPAL_FX_RATE = rupees per 1 USD. Update the rate to the current market rate.
PAYPAL_FX_RATE=88
# Day/hour boundaries on dashboard charts use this time zone
TIMEZONE=Asia/Kolkata
